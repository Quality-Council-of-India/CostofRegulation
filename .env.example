# Copy to .env and fill in before running `npm start` outside Docker.
# (If you run via Docker, pass these as -e flags or a docker-compose env_file instead —
# this .env file is only read by Node when you run the app directly with `npm start`/`npm run dev`.)

DATABASE_URL=postgres://localhost/cordashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run
SESSION_SECRET=replace-with-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-your-own-key-from-console.anthropic.com
# RESEARCH_MODEL=claude-opus-5-5
# PORT=3000
